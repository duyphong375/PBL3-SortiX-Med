# ==========================================
# SortiX-Med Monorepo .gitignore
# ==========================================

# --- Node / Web Dashboard (SortiX-Dashboard) ---
node_modules/
*/node_modules/
.pnp
.pnp.js
.yarn/install-state.gz

# Next.js & Frontend Build Outputs
.next/
*/.next/
out/
*/out/
dist/
*/dist/
build/
*/build/
.vercel/
*/.vercel/

# TypeScript & Cache
*.tsbuildinfo
next-env.d.ts

# Environment variables & secrets
.env
.env*.local
.env.production
.env.development
!.env.example
!*.env.example
*.pem

# Mobile / Android (Capacitor)
.gradle/
**/android/.gradle/
**/android/build/
**/android/app/build/
**/android/local.properties
*.apk

# --- ESP-IDF Firmware (sortix-firmware) ---
sortix-firmware/build/
sortix-firmware/.cache/
sortix-firmware/managed_components/
sortix-firmware/sdkconfig
sortix-firmware/sdkconfig.old

# Common build outputs
*.bin
*.elf
*.map

# --- OS & Editor artifacts ---
.DS_Store
Thumbs.db
desktop.ini
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# VS Code (preserve settings.json if needed, ignore workspace caches)
.vscode/*
!.vscode/settings.json
