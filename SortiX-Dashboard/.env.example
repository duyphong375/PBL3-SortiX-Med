# ==========================================
# CẤU HÌNH HỆ THỐNG SORTIX DASHBOARD
# ==========================================

# Port cấu hình
PORT=5000
NEXT_PUBLIC_API_URL=http://localhost:5000

# Địa chỉ WebSocket của MQTT broker
NEXT_PUBLIC_MQTT_BROKER_URL=wss://broker.emqx.io:8084/mqtt
NEXT_PUBLIC_MQTT_CLIENT_ID=dashboard_sorter_client
NEXT_PUBLIC_DEFAULT_DEVICE_ID=sorter_01

# Các topic MQTT
NEXT_PUBLIC_MQTT_TOPIC_CONFIG=sorter/sorter_01/config/set
NEXT_PUBLIC_MQTT_TOPIC_CONFIG_STATUS=sorter/sorter_01/config/status
NEXT_PUBLIC_MQTT_TOPIC_STATUS=sorter/sorter_01/status
NEXT_PUBLIC_MQTT_TOPIC_VISION=sorter/sorter_01/vision
NEXT_PUBLIC_MQTT_TOPIC_TELEMETRY=sorter/sorter_01/telemetry
NEXT_PUBLIC_MQTT_TOPIC_CONTROL=sorter/sorter_01/control
NEXT_PUBLIC_MQTT_TOPIC_ALERTS=sorter/sorter_01/alerts

# Cảnh báo Telegram Bot (Server Backend)
INTERNAL_API_SECRET=your_internal_api_secret_key
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Cảnh báo email SMTP (Server Backend)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password_here
ALERT_EMAIL_TO=manager@example.com
