# ==========================================
# CẤU HÌNH HỆ THỐNG SORTIX DASHBOARD
# ==========================================

# Port cấu hình
PORT=5000
NEXT_PUBLIC_API_URL=http://localhost:5000

# MQTT Broker URLs: kết nối server-side phải dùng TLS, browser dùng WSS
MQTT_BROKER_URL=mqtts://your-private-broker.example:8883
NEXT_PUBLIC_MQTT_BROKER_URL=wss://your-private-broker.example:443/mqtt
NEXT_PUBLIC_MQTT_CLIENT_ID=dashboard_sorter_client
MQTT_USERNAME=
MQTT_PASSWORD=
NEXT_PUBLIC_DEFAULT_DEVICE_ID=sorter_01

# Xác thực & Bảo mật (Secret Keys)
JWT_SECRET=your_secure_jwt_hmac_secret_key_here
MQTT_CONTROL_SECRET=your_firmware_control_secret_key_here
SORTIX_CONTROL_SECRET=your_firmware_control_secret_key_here
DEVICE_TOKEN=your_device_telemetry_token_here
ADMIN_BOOTSTRAP_PASSWORD=your_strong_admin_bootstrap_password_here
BOOTSTRAP_ADMIN_PASSWORD=your_strong_admin_bootstrap_password_here
ENABLE_DEMO_OTP=false

# Lưu trữ dữ liệu Production (Serverless / Database Adapter)
DATABASE_URL=postgres://user:password@hostname:5432/dbname

# Các topic MQTT
NEXT_PUBLIC_MQTT_TOPIC_CONFIG=sorter/sorter_01/config/set
NEXT_PUBLIC_MQTT_TOPIC_CONFIG_STATUS=sorter/sorter_01/config/status
NEXT_PUBLIC_MQTT_TOPIC_STATUS=sorter/sorter_01/status
NEXT_PUBLIC_MQTT_TOPIC_VISION=sorter/sorter_01/vision
NEXT_PUBLIC_MQTT_TOPIC_TELEMETRY=sorter/sorter_01/telemetry
NEXT_PUBLIC_MQTT_TOPIC_CONTROL=sorter/sorter_01/control
NEXT_PUBLIC_MQTT_TOPIC_ALERTS=sorter/sorter_01/alerts

# Cảnh báo Telegram Bot (Server Backend)
INTERNAL_API_SECRET=your_internal_api_secret_key_here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Cảnh báo email SMTP (Server Backend / Quên mật khẩu OTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password_here
ALERT_EMAIL_TO=manager@example.com

# Trợ lý AI Copilot (Gemini API)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
