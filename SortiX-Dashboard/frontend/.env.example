# ==========================================
# CẤU HÌNH SORTIX FRONTEND / VERCEL
# ==========================================

# Địa chỉ WebSocket của MQTT broker
NEXT_PUBLIC_MQTT_BROKER_URL=wss://broker.emqx.io:8084/mqtt
NEXT_PUBLIC_MQTT_CLIENT_ID=dashboard_sorter_client
NEXT_PUBLIC_DEFAULT_DEVICE_ID=sorter_01

# API Backend (nếu chạy riêng Backend độc lập)
NEXT_PUBLIC_API_URL=http://localhost:5000

# Trợ lý AI Copilot (Google Gemini API)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Cảnh báo Telegram & Email (nếu kích hoạt Next.js API Routes)
INTERNAL_API_SECRET=sortix_sec_internal_2026
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password_here
ALERT_EMAIL_TO=manager@example.com
