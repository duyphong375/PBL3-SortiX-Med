CONFIG_IDF_TARGET="esp32c5"

# Flash 8MB
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"

# PSRAM 8MB Quad SPI
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768

# Custom Partition Table (8MB Flash)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# FreeRTOS & System
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_COMPILER_OPTIMIZATION_DEFAULT=y

# Credentials and service endpoints must be provisioned per device/site.
CONFIG_SORTIX_WIFI_SSID=""
CONFIG_SORTIX_WIFI_PASSWORD=""
CONFIG_SORTIX_MQTT_BROKER_URI=""
CONFIG_SORTIX_HTTP_TELEMETRY_URL=""

# Verify HTTPS/MQTTS peers against ESP-IDF's trusted root bundle.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y

# Keep peripheral access used by the IRAM GPIO callback executable while the
# flash cache is disabled.
CONFIG_PCNT_CTRL_FUNC_IN_IRAM=y
CONFIG_PCNT_ISR_IRAM_SAFE=y
